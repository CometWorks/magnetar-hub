<?xml version="1.0"?>
<!-- Rollout draft: replace the empty Commit with the reviewed, merged plugin source commit,
     then rename to ErrorReporting.xml. Coordinate the matching PluginSdk using Docs/DiagnosticRollout.md. -->
<PluginData xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="GitHubPlugin">
    <Id>error-reporting</Id>
    <RepoId>CometWorks/error-reporting</RepoId>
    <FriendlyName>Error Reporting</FriendlyName>
    <Author>CometWorks</Author>
    <Tooltip>Required local server error and crash evidence capture</Tooltip>
    <Description>Required support plugin loaded by Magnetar. Captures bounded local Error/Critical logs and fatal exceptions.
External report sharing and crash-dump consent are controlled separately by Quasar.
Requires the Magnetar PluginSdk that exposes PluginSdk.Logging.Logger.EntryEmitted.</Description>
    <SourceDirectories>
        <Directory>ServerPlugin</Directory>
    </SourceDirectories>
    <Runtimes>CLR,CoreCLR</Runtimes>
    <Platforms>Windows,Linux</Platforms>
    <Hidden>true</Hidden>
    <Commit />
</PluginData>
